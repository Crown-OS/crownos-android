# Pinned inputs of the Venus tier build. Every source tarball is checked
# against its sha256, and the git archives also against the commit they embed.
# Bumping any pin means re-running build.sh and re-reading README.md "Rebasing".

VENUS_RELEASE=2026.11.0
# Timestamp of the release tarball entries: the Mesa commit time.
SOURCE_DATE_EPOCH=1783694425

# NDK r27c, Android 13 API level.
NDK_REVISION=27.2.12479018
ANDROID_API=33

# Mesa main 26.2.0-devel, 2026-07-10: the base the venus vtest patches are cut against.
MESA_COMMIT=a8ce4d829191939d8db4381a09dadcffdf6b5b7c
MESA_URL=https://gitlab.freedesktop.org/mesa/mesa/-/archive/$MESA_COMMIT/mesa-$MESA_COMMIT.tar.gz
MESA_SHA256=5f00da40259fd3744a9c5ed044093fd157daea324d49c89c427d578c08070293

# Mesa's libdrm wrap at that commit; meson checks the same hash.
LIBDRM_VERSION=2.4.133
LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-$LIBDRM_VERSION.tar.xz
LIBDRM_SHA256=fc68f9d0ba2ea63c9432a299e14fea09fad7a8a66e8039fcd7802ca59f77b4f5

# virglrenderer main after 1.3.0, 2026-07-06: the vtest protocol the guest patches speak.
VIRGL_COMMIT=dc35e4db03144f81637c5ad061f61d3334b078fe
VIRGL_URL=https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$VIRGL_COMMIT/virglrenderer-$VIRGL_COMMIT.tar.gz
VIRGL_SHA256=cf2c4ebf4bf4168b6d55b4cac63b37417db1167572c5f553c46d2a7cba961a5e

# Waydroid's minigbm: gbm_mesa_wrapper.h, the ABI of the vendor's gralloc.
MINIGBM_COMMIT=16844babfbd83d7c206ca22256257cbf26ca7de1
MINIGBM_URL=https://github.com/waydroid/android_external_minigbm/archive/$MINIGBM_COMMIT.tar.gz
MINIGBM_SHA256=e83e681c4633e375efd099344cb00e4d8ecd87e7c351c2b899c96039e9385b91
