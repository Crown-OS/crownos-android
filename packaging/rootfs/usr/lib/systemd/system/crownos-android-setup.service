# First-boot setup of Android apps (contract 12, `run`). It can wait for the
# network for a long time, so it is an exec service started after
# multi-user.target: a oneshot would hold its start job open for the whole
# download, and the boot would never finish.
# `remove --wipe-data` needs the home directories and runs through pkexec, never
# under this sandbox.

[Unit]
Description=Set up Android apps
Documentation=https://github.com/Crown-OS/crownos-android
ConditionPathExists=/var/lib/crownos/android/pending
Wants=network-online.target
After=network-online.target multi-user.target

[Service]
Type=exec
ExecStart=/usr/lib/crownos-android/crownos-android-setup run
Nice=19
IOSchedulingClass=idle
CPUWeight=20
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=-/etc/crownos
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
